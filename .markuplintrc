{
  "extends": [
    "markuplint:recommended"
  ],
  "parser": {
    ".erb$": "@markuplint/erb-parser"
  },
  "specs": {},
  "rules": {
    "require-h1": false,
    "require-attr": true,
    "require-accessible-name": false,
    "no-hardcoded-id": false
  },
  "nodeRules": [
    {
      "selector": "img",
      "rules": {
        "require-attr": "alt"
      }
    }
  ]
}
